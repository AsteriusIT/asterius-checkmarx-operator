{
  "name": "token",
  "priority": 5,
  "request": {
    "method": "POST",
    "urlPath": "/auth/realms/mock/protocol/openid-connect/token",
    "bodyPatterns": [
      {
        "contains": "grant_type=client_credentials"
      },
      {
        "contains": "client_id=mock-cli"
      },
      {
        "contains": "client_secret=mock-secret"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json",
      "X-Mock-Only": "true"
    },
    "body": "{\"access_token\": \"{{#assign 'claims'}}{\"tenant_name\": \"mock\", \"tenant_id\": \"organization::mock\", \"sub\": \"mock-cli\", \"ast-base-url\": \"{{#if request.headers.X-Forwarded-Proto}}{{request.headers.X-Forwarded-Proto}}://{{request.headers.Host}}{{else}}{{request.baseUrl}}{{/if}}\", \"exp\": 4102444800, \"iat\": 1767225600, \"ast-license\": {\"LicenseData\": {\"allowedEngines\": [\"sast\", \"sca\", \"kics\", \"containers\"], \"dastEnabled\": false}}, \"roles_ast\": [\"view-projects\", \"create-projects\", \"create-scan\", \"view-scans\"]}{{/assign}}eyJhbGciOiAiSFMyNTYiLCAidHlwIjogIkpXVCJ9.{{{replace (replace (base64 claims padding=false) '+' '-') '/' '_'}}}.Ik1PQ0stT05MWS1OT1QtQS1SRUFMLVNJR05BVFVSRSI\", \"token_type\": \"Bearer\", \"expires_in\": 3600, \"refresh_token\": \"mock-refresh-token\", \"refresh_expires_in\": 3600}"
  }
}
