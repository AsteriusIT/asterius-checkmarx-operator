    "body": "{\"exportId\": \"mock-export\", \"exportStatus\": \"Completed\", \"fileUrl\": \"{{#if request.headers.X-Forwarded-Proto}}{{request.headers.X-Forwarded-Proto}}://{{request.headers.Host}}{{else}}{{request.baseUrl}}{{/if}}/mock-export/report.json\"}"
  }
}
